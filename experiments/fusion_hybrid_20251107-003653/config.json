{
    "model": {
        "name": "hybrid_fusion",
        "fusion_type": "hybrid",
        "num_classes": 8
    },
    "audio": {
        "input_shape": [
            128,
            128,
            1
        ],
        "model_path": null,
        "spectrograms_path": "processed/audio_spectrograms"
    },
    "video": {
        "input_shape": [
            30,
            20
        ],
        "model_path": null,
        "features_path": "processed/video_features"
    },
    "training": {
        "batch_size": 32,
        "epochs": 100,
        "learning_rate": 0.001,
        "weight_decay": 0.0001,
        "early_stopping_patience": 25,
        "reduce_lr_patience": 10,
        "reduce_lr_factor": 0.5
    },
    "data": {
        "audio_speech_path": "processed/audio_spectrograms/speech",
        "audio_song_path": "processed/audio_spectrograms/song",
        "video_speech_path": "processed/video_features/speech/scaled_video_features.csv",
        "video_song_path": "processed/video_features/song/scaled_video_features.csv",
        "use_song_data": true,
        "test_size": 0.2,
        "validation_size": 0.2,
        "random_state": 42,
        "video_sequence_length": 30
    },
    "augmentation": {
        "enabled": true,
        "audio_augment": true,
        "video_augment": true,
        "mixup_alpha": 0.4
    }
}