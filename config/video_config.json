{
    "model": {
        "name": "video_cnn_lstm_attention",
        "input_shape": [100, 20],
        "cnn_filters": [32, 64, 128],
        "cnn_kernel_size": 3,
        "cnn_pool_size": 2,
        "lstm_units": 128,
        "lstm_layers": 2,
        "dense_units": [256, 128],
        "dropout_rate": 0.5,
        "attention_units": 64,
        "num_classes": 8
    },
    "training": {
        "batch_size": 32,
        "epochs": 50,
        "learning_rate": 0.0001,
        "weight_decay": 0.00001,
        "early_stopping_patience": 10,
        "reduce_lr_patience": 5,
        "reduce_lr_factor": 0.5
    },
    "data": {
        "speech_features_path": "processed/video_features/speech/scaled_video_features.csv",
        "song_features_path": "processed/video_features/song/scaled_video_features.csv",
        "use_song_data": true,
        "test_size": 0.2,
        "validation_size": 0.2,
        "random_state": 42,
        "sequence_length": 100,
        "feature_columns": [
            "left_eye_ear", "right_eye_ear", "avg_eye_ear",
            "mouth_aspect_ratio", "left_eyebrow_eye_dist", "right_eyebrow_eye_dist",
            "mouth_face_width_ratio", "smile_ratio", "nose_wrinkle",
            "eye_openness_ratio", "eye_asymmetry", "eyebrow_asymmetry",
            "jaw_asymmetry", "inner_mouth_openness",
            "hog_mean", "hog_std", "face_brightness", "face_contrast",
            "edge_intensity_mean", "edge_intensity_std"
        ]
    },
    "augmentation": {
        "enabled": true,
        "time_masking": true,
        "feature_masking": true,
        "gaussian_noise": 0.01
    }
}